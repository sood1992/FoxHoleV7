# ===========================================
# FOXHOLE ENTERPRISE OS - ENVIRONMENT CONFIG
# ===========================================
# Copy this file to .env and update values

# Database Configuration
# For cPanel: use yourusername_dbname format
DB_HOST=localhost
DB_NAME=foxhole
DB_USER=root
DB_PASS=

# JWT Configuration
# IMPORTANT: Generate a strong random key for production!
# Use: openssl rand -hex 32
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRY=900
REFRESH_TOKEN_EXPIRY=604800

# Application Settings
APP_URL=http://localhost/foxhole
APP_ENV=development
APP_DEBUG=true

# CORS - Frontend URL (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# File Uploads
UPLOAD_MAX_SIZE=52428800

# WhatsApp Integration (Optional)
TWILIO_SID=optional-twilio-sid
TWILIO_AUTH_TOKEN=optional-twilio-token
TWILIO_WHATSAPP_NUMBER=+14155238886
