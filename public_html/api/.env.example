# ===========================================
# FOXHOLE ENTERPRISE OS - API CONFIGURATION
# ===========================================
# Copy this file to .env and update values
# Place in: public_html/api/.env

# Database Configuration
# For cPanel: use yourusername_dbname format
DB_HOST=localhost
DB_NAME=yourusername_foxhole
DB_USER=yourusername_foxhole
DB_PASS=your_secure_password

# JWT Configuration
# IMPORTANT: Generate a strong random key!
# Use: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-64-character-string
JWT_EXPIRY=900
REFRESH_TOKEN_EXPIRY=604800

# Application Settings
APP_URL=https://yourdomain.com/api
APP_ENV=production
APP_DEBUG=false

# CORS - Your frontend URL (no trailing slash)
# Since frontend and API are on same domain, use the domain
CORS_ORIGIN=https://yourdomain.com

# File Uploads
UPLOAD_MAX_SIZE=52428800
UPLOAD_PATH=../uploads

# WhatsApp Integration (Optional)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
